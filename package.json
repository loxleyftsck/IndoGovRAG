{
    "name": "indogovrag",
    "version": "0.1.0",
    "description": "Production-ready RAG system for Indonesian government documents",
    "main": "src/rag/pipeline.py",
    "scripts": {
        "test": "pytest tests/",
        "lint": "ruff check .",
        "lint:fix": "ruff check --fix .",
        "format": "ruff format .",
        "format:check": "ruff format --check .",
        "type-check": "mypy src/ api/",
        "security": "bandit -r src/ api/ && safety check",
        "dev": "uvicorn api.main:app --reload",
        "build": "docker-compose build",
        "start": "docker-compose up -d",
        "stop": "docker-compose down",
        "clean": "make clean",
        "validate": "python scripts/validate_dataset.py"
    },
    "keywords": [
        "rag",
        "retrieval-augmented-generation",
        "indonesian",
        "nlp",
        "government-documents",
        "jdih",
        "gemini",
        "chromadb"
    ],
    "author": "Your Name <your.email@example.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/indogovrag.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/indogovrag/issues"
    },
    "homepage": "https://github.com/yourusername/indogovrag#readme",
    "dependencies": {
        "dompurify": "^3.3.1",
        "playwright": "^1.60.0"
    }
}
